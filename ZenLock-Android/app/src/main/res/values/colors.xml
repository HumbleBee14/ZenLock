<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Colors -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="transparent">#00000000</color>

    <!-- Modern Minimal Color Palette -->
    <!-- Primary Colors (Refined Slate-Blue — calm, confident, SaaS-grade) -->
    <color name="primary">#4263EB</color>           <!-- Slate-blue, less candy than indigo -->
    <color name="primaryDark">#364FC7</color>       <!-- Deeper slate for pressed states -->
    <color name="primaryLight">#5C7CFA</color>      <!-- Soft slate-blue for highlights -->

    <!-- Gradient Support Colors (used only on hero CTAs) -->
    <color name="gradientStart">#4263EB</color>      <!-- Slate-blue start -->
    <color name="gradientEnd">#5C7CFA</color>        <!-- Soft slate-blue end (single-hue, no purple) -->
    
    <!-- Secondary Colors (Professional Gray) -->
    <color name="secondary">#6B7280</color>         <!-- Professional gray for accents -->
    <color name="secondaryDark">#4B5563</color>     <!-- Dark gray for contrast -->
    <color name="secondaryLight">#9CA3AF</color>    <!-- Light gray for subtle elements -->
    
    <!-- Accent Colors (Professional Status) -->
    <color name="accent">#10B981</color>            <!-- Success green -->
    <color name="accentWarning">#F59E0B</color>     <!-- Warning amber -->
    <color name="accentDanger">#DC2626</color>      <!-- Professional error red -->
    
    <!-- Background Colors (Balanced Dark Theme) -->
<!--    <color name="backgroundPrimary">#121416</color>     &lt;!&ndash; Softer dark background &ndash;&gt;-->
    <color name="backgroundPrimary">#121416</color>     <!-- Darker background for better contrast -->
    <color name="backgroundSecondary">#1C1F23</color>   <!-- Card/surface background -->
    <color name="backgroundTertiary">#30353B</color>    <!-- Elevated surfaces -->
    
    <!-- Text Colors (Professional Hierarchy) -->
    <color name="textPrimary">#F4F5F7</color>       <!-- Main text - near white -->
    <color name="textSecondary">#BBC1CA</color>     <!-- Secondary text - light gray -->
    <color name="textTertiary">#939CA8</color>      <!-- Tertiary text - medium gray -->
    <color name="textHint">#939CA8</color>          <!-- Hint text - darker gray -->
    
    <!-- Surface Colors (Cards & Components) -->
    <color name="surface">#1C1F23</color>           <!-- Card backgrounds -->
    <color name="surfaceElevated">#25292E</color>   <!-- Elevated cards -->
    <color name="surfaceHighlight">#343A41</color>  <!-- Highlighted surfaces -->
    
    <!-- Border & Divider Colors -->
    <color name="border">#343A41</color>            <!-- Subtle borders -->
    <color name="borderLight">#444B54</color>       <!-- Lighter borders -->
    <color name="divider">#343A41</color>           <!-- Section dividers -->
    
    <!-- Status Colors -->
    <color name="success">#10B981</color>           <!-- Success states -->
    <color name="success_dark">#059669</color>      <!-- Darker success for borders -->
    <color name="warning">#F59E0B</color>           <!-- Warning states -->
    <color name="error">#DC2626</color>             <!-- Professional error states -->
    <color name="info">#3B82F6</color>              <!-- Info states -->
    <color name="warningText">#D97706</color>       <!-- Warning text color -->
    <color name="warningBackground">#FEF3C7</color> <!-- Warning banner background -->
    
    <!-- Card Background -->
    <color name="card_background">#1C1F23</color>   <!-- Card backgrounds for permissions -->
    
    <!-- Legacy Compatibility (Gradually Remove) -->
    <color name="primaryTeal">@color/primary</color>
    <color name="darkTeal">@color/primaryDark</color>
    <color name="lightTeal">@color/primaryLight</color>
    <color name="luxuryBackground">@color/backgroundPrimary</color>
    <color name="darkBackground">@color/backgroundSecondary</color>
    <color name="lightGrey">@color/textSecondary</color>
    
    <!-- Navigation Colors -->
    <color name="navigationBarColor">@color/backgroundSecondary</color>
    <color name="bottomNavSelectedItem">@color/primary</color>
    <color name="bottomNavUnselectedItem">@color/textTertiary</color>
    
    <!-- Additional Colors for Schedule Feature -->
    <color name="gray">#808080</color>
    <color name="light_gray">#D3D3D3</color>
    <color name="dark_gray">#404040</color>
    <color name="green">#4CAF50</color>
    <color name="background_light">#F5F5F5</color>
    <color name="surface_dark">#121416</color>

    <!-- Premium Accent Colors -->
    <color name="primaryGlow">#406366F1</color>         <!-- Soft glow behind key elements -->
    <color name="scoreGold">#FBBF24</color>             <!-- Warm gold for focus score -->
    <color name="scoreGoldDark">#D97706</color>         <!-- Darker gold for score ring track -->
    <color name="cardBorderSubtle">#1FFFFFFF</color>    <!-- Very subtle card borders -->
    <color name="chipSelectedBg">#206366F1</color>      <!-- Selected chip background -->
    <color name="dividerSubtle">#1AFFFFFF</color>       <!-- Subtle divider -->

    <!-- Time Picker Colors -->
    <color name="time_picker_surface_lavender">#EDE7F6</color>
</resources>

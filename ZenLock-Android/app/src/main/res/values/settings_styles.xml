<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Settings.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:paddingStart">4dp</item>
    </style>
    <style name="Settings.SectionIcon" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Settings.SectionTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
    <style name="Settings.Group" parent="Zen.Group">
        <item name="android:background">@drawable/settings_group_background</item>
    </style>
    <style name="Settings.Row" parent="Zen.Row">
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Settings.Row.Clickable" parent="Settings.Row">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Settings.RowCopy" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="Settings.RowTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
    <style name="Settings.RowSummary" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/textTertiary</item>
    </style>
    <style name="Settings.Divider" parent="Zen.RowDivider">
        <item name="android:layout_marginEnd">16dp</item>
    </style>
</resources>

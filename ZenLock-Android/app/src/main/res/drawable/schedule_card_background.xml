<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/primaryRipple">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="@color/surface" />
                    <stroke android:width="1dp" android:color="@color/primaryBorder" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface" />
                    <stroke android:width="1dp" android:color="@color/dividerSubtle" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

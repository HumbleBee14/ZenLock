<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Set PIN"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/textPrimary" />

    <TextView
        android:id="@+id/instructionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="@color/textSecondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/newPinInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/zen_field_background"
            android:hint="PIN"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:gravity="center"
            android:textSize="18sp"
            android:letterSpacing="0.3"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textHint" />

        <EditText
            android:id="@+id/confirmPinInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/zen_field_background"
            android:hint="Confirm"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:imeOptions="actionDone"
            android:gravity="center"
            android:textSize="18sp"
            android:letterSpacing="0.3"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textHint" />

    </LinearLayout>

    <TextView
        android:id="@+id/pinStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textColor="@color/error"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pinCancelButton"
            style="@style/ModernButton.Pill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:layout_marginEnd="8dp"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pinSaveButton"
            style="@style/ModernButton.Pill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:text="Set PIN" />

    </LinearLayout>

</LinearLayout>

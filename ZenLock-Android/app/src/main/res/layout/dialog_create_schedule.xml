<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/sheet_handle" />

        <TextView
            android:id="@+id/scheduleDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="New schedule"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/textPrimary" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/zen_field_background"
            android:hint="Schedule name"
            android:textSize="15sp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textHint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textCapWords"
            android:imeOptions="actionDone"
            android:maxLength="23"
            android:maxLines="1" />

        <LinearLayout
            android:id="@+id/startTimeRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Starts"
                android:textSize="15sp"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/startTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:00 AM"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/primaryLight" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/textTertiary"
                android:contentDescription="@null" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dividerSubtle" />

        <LinearLayout
            android:id="@+id/durationRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Duration"
                android:textSize="15sp"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/selectedDurationDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set duration"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/primaryLight" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/textTertiary"
                android:contentDescription="@null" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dividerSubtle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Repeat"
            android:textSize="15sp"
            android:textColor="@color/textPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/onceChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Once" />

            <com.google.android.material.chip.Chip
                android:id="@+id/dailyChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Daily" />

            <com.google.android.material.chip.Chip
                android:id="@+id/weeklyChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Weekly" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/weeklyDaysLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.chip.Chip
                android:id="@+id/sundayChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="S" />

            <com.google.android.material.chip.Chip
                android:id="@+id/mondayChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="M" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tuesdayChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="T" />

            <com.google.android.material.chip.Chip
                android:id="@+id/wednesdayChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="W" />

            <com.google.android.material.chip.Chip
                android:id="@+id/thursdayChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="T" />

            <com.google.android.material.chip.Chip
                android:id="@+id/fridayChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="F" />

            <com.google.android.material.chip.Chip
                android:id="@+id/saturdayChip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="S" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notify before"
                android:textSize="15sp"
                android:textColor="@color/textPrimary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/preNotifySwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:theme="@style/AppTheme.Switch" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/preNotifyOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.chip.Chip
                android:id="@+id/notify1Chip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="1m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/notify2Chip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="2m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/notify3Chip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="3m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/notify5Chip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="5m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/notify10Chip"
                style="@style/ZenChip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="10m" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/ModernButton.Pill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:layout_marginEnd="8dp"
                android:text="Cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createButton"
                style="@style/ModernButton.Pill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:text="Create" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

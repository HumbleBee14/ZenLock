<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrimary"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:animateLayoutChanges="true">
        <LinearLayout
            android:id="@+id/mainContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/sessionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Focus"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textColor="@color/textTertiary"
                android:maxLines="1"
                android:ellipsize="end" />
            <FrameLayout
                android:id="@+id/timerContainer"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/timerCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="00:25"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:fontFamily="sans-serif-thin"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="36sp"
                    android:autoSizeMaxTextSize="64sp" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/timerProgressTrack"
                android:layout_width="200dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/hairline_track"
                android:visibility="gone">
                <View
                    android:id="@+id/timerProgressFill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hairline_fill" />
            </FrameLayout>
            <TextView
                android:id="@+id/endsAtText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ends at 10:30 AM"
                android:textSize="13sp"
                android:textColor="@color/textSecondary" />
            <TextView
                android:id="@+id/lockscreenMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stay focused, stay productive!"
                android:textSize="15sp"
                android:textColor="@color/textSecondary"
                android:fontFamily="sans-serif-light"
                android:lineSpacingMultiplier="1.3"
                android:gravity="center"
                android:maxLines="3"
                android:layout_marginTop="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />
            <ImageView
                android:id="@+id/unlockArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_expand_more"
                android:background="@drawable/glass_card_inner"
                android:padding="8dp"
                android:contentDescription="Show unlock options"
                android:alpha="1"
                android:layout_marginTop="16dp" />
            <LinearLayout
                android:id="@+id/unlockExtendButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:alpha="0.0">
                <Button
                    android:id="@+id/unlockPromptButton"
                    style="@style/ModernButton.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Unlock" />
                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/extendLockButton"
                    style="@style/ModernButton.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Extend" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/unlockInputsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/pin_input_background"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginBottom="20dp">
                    <EditText
                        android:id="@+id/pinInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="Enter 4-digit PIN"
                        android:textColor="@color/white"
                        android:textColorHint="@color/textHint"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:background="@null"
                        android:padding="0dp"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:textCursorDrawable="@null"
                        android:letterSpacing="0.15" />
                    <ImageView
                        android:id="@+id/pinVisibilityToggle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_eye"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:contentDescription="Toggle PIN visibility"
                        android:alpha="0.8" />
                </LinearLayout>
                <Button
                    android:id="@+id/unlockButton"
                    style="@style/ModernButton.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Confirm Unlock" />
            </LinearLayout>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:id="@+id/parentAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/defaultAppsRecycler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/group_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/noAppsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginTop="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_apps"
                    android:alpha="0.5"
                    app:tint="@color/textSecondary"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No apps allowed"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/expandButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="0dp">
            <ImageView
                android:id="@+id/expandAppsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_expand_more"
                android:rotation="180"
                android:background="@drawable/circular_button"
                android:padding="10dp"
                android:contentDescription="@string/show_allowed_apps"
                android:alpha="0.9" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrimary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        tools:context=".fragments.SettingsFragment">

        <TextView
            android:id="@+id/settingsTitle"
            style="@style/ModernText.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Settings" />

        <TextView style="@style/Zen.SectionLabel" android:text="Apps" />

        <LinearLayout style="@style/Zen.Group">

            <LinearLayout
                android:id="@+id/whitelistButton"
                style="@style/Zen.Row.Clickable">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allowed Apps"
                        android:textSize="15sp"
                        android:textColor="@color/textPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/allowed_apps_summary"
                        android:textSize="12sp"
                        android:textColor="@color/textTertiary" />

                </LinearLayout>

                <ImageView style="@style/Zen.Chevron" android:contentDescription="@null" />

            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout
                android:id="@+id/defaultAppsHeader"
                style="@style/Zen.Row.Clickable">

                <TextView style="@style/Zen.RowLabel" android:text="Default Allowed Apps" />

                <ImageView
                    android:id="@+id/defaultAppsExpandIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/textTertiary"
                    android:contentDescription="@null" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/defaultAppsExpandableContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/Zen.Row" android:paddingStart="32dp" android:minHeight="44dp">
                    <TextView style="@style/Zen.RowLabel" android:text="Phone" android:textSize="14sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/phoneAppToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/AppTheme.Switch" />
                </LinearLayout>

                <LinearLayout style="@style/Zen.Row" android:paddingStart="32dp" android:minHeight="44dp">
                    <TextView style="@style/Zen.RowLabel" android:text="Calendar" android:textSize="14sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/calendarAppToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/AppTheme.Switch" />
                </LinearLayout>

                <LinearLayout style="@style/Zen.Row" android:paddingStart="32dp" android:minHeight="44dp">
                    <TextView style="@style/Zen.RowLabel" android:text="Clock" android:textSize="14sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/clockAppToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/AppTheme.Switch" />
                </LinearLayout>

            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="Block Notifications" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/blockNotificationsToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

        </LinearLayout>

        <TextView style="@style/Zen.SectionLabel" android:text="Unlock" />

        <LinearLayout style="@style/Zen.Group">

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="PIN Unlock" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearPinButton"
                    style="@style/ModernButton.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:minHeight="30dp"
                    android:layout_marginEnd="10dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Clear"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/pinUnlockToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="Accountability Partner" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/partnerUnlockToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/partnerConfigSection"
                style="@style/Zen.Row.Clickable"
                android:paddingStart="32dp"
                android:minHeight="44dp"
                android:visibility="gone">

                <TextView style="@style/Zen.RowLabel" android:text="Partner Contact" android:textSize="14sp" />

                <TextView
                    android:id="@+id/partnerConfigValue"
                    style="@style/Zen.RowValue"
                    android:text="Configure" />

                <ImageView style="@style/Zen.Chevron" android:contentDescription="@null" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/noUnlockMethodsWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/warning"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No unlock method set. You stay locked until the timer ends."
                android:textSize="12sp"
                android:textColor="@color/textSecondary" />

        </LinearLayout>

        <TextView style="@style/Zen.SectionLabel" android:text="Reliability" />

        <LinearLayout style="@style/Zen.Group">

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="Unrestricted Battery" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/batteryExemptionToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="Resume After Reboot" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoRestartToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout
                android:id="@+id/permissionsRow"
                style="@style/Zen.Row.Clickable">
                <TextView style="@style/Zen.RowLabel" android:text="Permissions" />
                <ImageView style="@style/Zen.Chevron" android:contentDescription="@null" />
            </LinearLayout>

        </LinearLayout>

        <TextView style="@style/Zen.SectionLabel" android:text="Lock screen" />

        <LinearLayout style="@style/Zen.Group">

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="Motivational Quotes" />
                <ImageView
                    android:id="@+id/addQuoteButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/primaryLight"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Add quote" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/quotesToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="Circular Timer" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/circularTimerToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="Vibration Feedback" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/vibrationToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="Session Notification" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/persistentNotificationToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout style="@style/Zen.Row">
                <TextView style="@style/Zen.RowLabel" android:text="Allow Home Screen" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/allowLauncherToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/AppTheme.Switch" />
            </LinearLayout>

        </LinearLayout>

        <TextView style="@style/Zen.SectionLabel" android:text="About" />

        <LinearLayout style="@style/Zen.Group">

            <LinearLayout
                android:id="@+id/supportDeveloperCard"
                style="@style/Zen.Row.Clickable">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/error"
                    android:contentDescription="@null" />

                <TextView style="@style/Zen.RowLabel" android:text="Support the Developer" />
                <ImageView style="@style/Zen.Chevron" android:contentDescription="@null" />

            </LinearLayout>

            <View style="@style/Zen.RowDivider" />

            <LinearLayout
                android:id="@+id/feedbackCard"
                style="@style/Zen.Row.Clickable">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_message"
                    app:tint="@color/textSecondary"
                    android:contentDescription="@null" />

                <TextView style="@style/Zen.RowLabel" android:text="Send Feedback" />
                <ImageView style="@style/Zen.Chevron" android:contentDescription="@null" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center"
            android:text="Free and open source, built to help people focus. Your feedback and support keep it going."
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/textSecondary" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/textTertiary" />

    </LinearLayout>

</ScrollView>

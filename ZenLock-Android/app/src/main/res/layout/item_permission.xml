<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="5dp">

    <ImageView
        android:id="@+id/permissionIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="12dp"
        app:tint="@color/textSecondary"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/permissionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/textPrimary" />

        </LinearLayout>

        <TextView
            android:id="@+id/permissionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/textSecondary" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/permissionEnable"
        style="@style/ModernButton.Pill"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:minHeight="30dp"
        android:layout_marginStart="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Enable"
        android:textSize="12sp"
 />

    <ImageView
        android:id="@+id/permissionGranted"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/ic_check"
        app:tint="@color/primary"
        android:visibility="gone"
        android:contentDescription="Granted" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/permissionIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="14dp"
        app:tint="@color/textSecondary"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/permissionTitle"
                style="@style/ModernText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/permissionOptional"
                style="@style/ModernText.MetricLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="OPTIONAL"
                android:textColor="@color/textSecondary"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/permissionReason"
            style="@style/ModernText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/textSecondary" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/permissionEnable"
        style="@style/ModernButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minHeight="36dp"
        android:layout_marginStart="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Enable"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/permissionGranted"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_check"
        app:tint="@color/primary"
        android:visibility="gone"
        android:contentDescription="Granted" />

</LinearLayout>

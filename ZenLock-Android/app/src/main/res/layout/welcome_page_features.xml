<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/layout_focus_your_way"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:textColor="@color/textPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="@string/layout_everything_you_need_nothing_that_pulls_you_back"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@color/textSecondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <LinearLayout
            style="@style/Zen.FeatureTile"
            android:layout_marginEnd="6dp"
            android:layout_marginStart="0dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/primaryLight"
                android:contentDescription="@null" />

            <TextView
                style="@style/Zen.FeatureTitle"
                android:text="@string/layout_lock_it" />

            <TextView
                style="@style/Zen.FeatureText"
                android:text="@string/layout_for_25_minutes_or_every_weekday_morning_on_a_schedule" />

        </LinearLayout>

        <LinearLayout
            style="@style/Zen.FeatureTile"
            android:layout_marginEnd="0dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_phone"
                app:tint="@color/primaryLight"
                android:contentDescription="@null" />

            <TextView
                style="@style/Zen.FeatureTitle"
                android:text="@string/layout_essentials_stay" />

            <TextView
                style="@style/Zen.FeatureText"
                android:text="@string/layout_phone_clock_and_calendar_plus_up_to_8_apps_you_pick" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <LinearLayout
            style="@style/Zen.FeatureTile"
            android:layout_marginEnd="6dp"
            android:layout_marginStart="0dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_person"
                app:tint="@color/primaryLight"
                android:contentDescription="@null" />

            <TextView
                style="@style/Zen.FeatureTitle"
                android:text="@string/layout_no_easy_exit" />

            <TextView
                style="@style/Zen.FeatureText"
                android:text="@string/layout_a_pin_or_a_trusted_partner_decides_when_you_end_early" />

        </LinearLayout>

        <LinearLayout
            style="@style/Zen.FeatureTile"
            android:layout_marginEnd="0dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_heart"
                app:tint="@color/primaryLight"
                android:contentDescription="@null" />

            <TextView
                style="@style/Zen.FeatureTitle"
                android:text="@string/layout_free_always" />

            <TextView
                style="@style/Zen.FeatureText"
                android:text="@string/layout_open_source_no_ads_no_tracking_no_upsell" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="36dp"
    android:paddingEnd="36dp">

    <TextView
        style="@style/ModernText.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="@string/layout_where_attention_goes" />

    <LinearLayout
        android:id="@+id/factCard1"
        style="@style/Zen.FactCard"
        android:rotation="-2.5"
        android:background="@drawable/group_background">

        <TextView style="@style/Zen.FactValue" android:text="@string/layout_96" />
        <TextView style="@style/Zen.FactLabel" android:text="@string/layout_times_a_day_the_average_person_checks_their_phone_about_on" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/factCard2"
        style="@style/Zen.FactCard"
        android:layout_marginTop="14dp"
        android:rotation="2"
        android:background="@drawable/zen_field_background">

        <TextView style="@style/Zen.FactValue" android:text="@string/layout_47_sec" />
        <TextView style="@style/Zen.FactLabel" android:text="@string/layout_average_attention_on_one_screen_before_switching_it_was_2_" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/factCard3"
        style="@style/Zen.FactCard"
        android:layout_marginTop="14dp"
        android:rotation="-1.5"
        android:background="@drawable/group_background">

        <TextView style="@style/Zen.FactValue" android:text="@string/layout_23_min" />
        <TextView style="@style/Zen.FactLabel" android:text="@string/layout_to_get_fully_back_into_deep_work_after_a_single_interrupti" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/factCard4"
        style="@style/Zen.FactCard"
        android:layout_marginTop="14dp"
        android:rotation="1.5"
        android:background="@drawable/zen_field_background">

        <TextView style="@style/Zen.FactValue" android:text="@string/layout_40_days" />
        <TextView style="@style/Zen.FactLabel" android:text="@string/layout_a_year_spent_looking_at_a_phone_at_today_s_average_of_over" />

    </LinearLayout>

</LinearLayout>

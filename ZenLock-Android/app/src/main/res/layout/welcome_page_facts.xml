<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="36dp"
    android:paddingEnd="36dp">

    <TextView
        style="@style/ModernText.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="Where attention goes" />

    <LinearLayout
        android:id="@+id/factCard1"
        style="@style/Zen.FactCard"
        android:rotation="-2.5"
        android:background="@drawable/group_background">

        <TextView style="@style/Zen.FactValue" android:text="96" />
        <TextView style="@style/Zen.FactLabel" android:text="times a day the average person checks their phone. About once every ten minutes." />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/factCard2"
        style="@style/Zen.FactCard"
        android:layout_marginTop="14dp"
        android:rotation="2"
        android:background="@drawable/zen_field_background">

        <TextView style="@style/Zen.FactValue" android:text="47 sec" />
        <TextView style="@style/Zen.FactLabel" android:text="average attention on one screen before switching. It was 2½ minutes twenty years ago." />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/factCard3"
        style="@style/Zen.FactCard"
        android:layout_marginTop="14dp"
        android:rotation="-1.5"
        android:background="@drawable/group_background">

        <TextView style="@style/Zen.FactValue" android:text="23 min" />
        <TextView style="@style/Zen.FactLabel" android:text="to get fully back into deep work after a single interruption." />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/factCard4"
        style="@style/Zen.FactCard"
        android:layout_marginTop="14dp"
        android:rotation="1.5"
        android:background="@drawable/zen_field_background">

        <TextView style="@style/Zen.FactValue" android:text="40+ days" />
        <TextView style="@style/Zen.FactLabel" android:text="a year spent looking at a phone, at today's average of over three hours a day." />

    </LinearLayout>

</LinearLayout>
